{
  "name": "dukou-workbuddy-bridge-demo",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "main": "electron/main.cjs",
  "productName": "Relay Chat Demo",
  "author": "Cheng Lei",
  "description": "A local-first WorkBuddy-style chat receiver for WeChat archives delivered from Dukou.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leicheng42/dukou-workbuddy-bridge-demo.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop:dev": "node scripts/dev-desktop.mjs",
    "desktop": "npm run build && electron electron/main.cjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "4.1.12"
  }
}
